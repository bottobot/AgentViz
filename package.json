{
  "name": "agent-viz",
  "displayName": "AgentViz",
  "description": "A local, live picture of Claude Code and Codex sessions in an editor tab.",
  "version": "0.1.0",
  "publisher": "agentviz-local",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Visualization"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onCommand:agentviz.open",
    "onCommand:agentviz.openSession"
  ],
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentviz",
          "title": "AgentViz",
          "icon": "resources/agentviz.svg"
        }
      ]
    },
    "views": {
      "agentviz": [
        {
          "id": "agentviz.home",
          "name": "Activity"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agentviz.home",
        "contents": "A live picture of your Claude Code and Codex sessions.\n[Open Activity](command:agentviz.open)\n[Settings](command:agentviz.settings)"
      }
    ],
    "commands": [
      {
        "command": "agentviz.open",
        "title": "AgentViz: Open Activity",
        "icon": "$(graph)"
      },
      {
        "command": "agentviz.settings",
        "title": "AgentViz: Settings",
        "icon": "$(gear)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentviz.open",
          "when": "view == agentviz.home",
          "group": "navigation@1"
        },
        {
          "command": "agentviz.settings",
          "when": "view == agentviz.home",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "AgentViz",
      "properties": {
        "agentviz.claudeRoot": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Claude configuration folder. Empty uses the local .claude folder. Only its projects folder is read."
        },
        "agentviz.scope": {
          "type": "string",
          "enum": [
            "workspace",
            "all"
          ],
          "enumDescriptions": [
            "Only sessions recorded in an open workspace folder or below it (worktrees included).",
            "Every session in the configured Claude and Codex folders."
          ],
          "default": "workspace",
          "description": "Which sessions AgentViz lists. With no folder open, every session is listed."
        },
        "agentviz.codexRoot": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Codex configuration folder. Empty uses the local .codex folder. Only its sessions folder is read."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check src/extension.js && node --check src/transcript.js && node --check src/sessions.js && node --check src/webview.js && node --check src/detail.js && node --check media/view.js && node --check media/app.js",
    "host": "node test/host-runner.js",
    "browser": "node test/browser-check.js",
    "package": "vsce package --no-dependencies --allow-missing-repository --skip-license",
    "package:check": "node test/vsix-check.js"
  },
  "devDependencies": {
    "@vscode/vsce": "4.1.0"
  },
  "overrides": {
    "@vscode/vsce": {
      "minimatch": "^11.0.8"
    }
  }
}
